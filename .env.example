# Copy to .env and adjust as needed. docker-compose reads this automatically.

# TimescaleDB credentials (internal to the compose network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=telemetry
POSTGRES_DB=telemetry

# The only published host port — OpenMCT plus the /api and /ws proxy.
MISSIONCONTROL_PORT=8080

# Loopback-only ports used ONLY with docker-compose.debug.yml. High ports,
# chosen to stay clear of native dev servers (8000/8001), Kalshi's containers
# (6379/6543), and any native Postgres (5432).
API_DEBUG_PORT=18000
DB_DEBUG_PORT=15432

# Space link fault injection (0.0 - 1.0)
DROP_PROB=0.02
CORRUPT_PROB=0.01
